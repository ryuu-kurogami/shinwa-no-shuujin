# Copiá este archivo a ".env" y completá con tus propios valores.
# Los sacás del panel de Supabase: Project Settings > API

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Tu email de Google (el que vas a usar para loguearte) — separá con comas si hay más de un admin
VITE_ADMIN_EMAILS=tuemail@gmail.com

# Sacalo del panel de Cloudflare Turnstile (gratis) — protege el formulario de comentarios de bots
VITE_TURNSTILE_SITE_KEY=tu-turnstile-site-key
